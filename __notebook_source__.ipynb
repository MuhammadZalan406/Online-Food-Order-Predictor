import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, classification_report
from sklearn.feature_selection import SelectKBest, chi2
import warnings
warnings.filterwarnings('ignore')

# ============================================
# STEP 1: DATA LOADING
# ============================================
print("="*60)
print("🚀 STEP 1: DATA LOADING")
print("="*60)

file_path = '/kaggle/input/datasets/srisyra02/online-food-ordering-dataset/online food delivery dataset.csv'
df = pd.read_csv(file_path)

print(f"✅ Dataset Loaded Successfully!")
print(f"📏 Shape: {df.shape[0]} rows, {df.shape[1]} columns")
print(f"\n📋 Columns: {df.columns.tolist()}")

# ============================================
# STEP 2: DATA CLEANING
# ============================================
print("\n" + "="*60)
print("🧹 STEP 2: DATA CLEANING")
print("="*60)

# 1. Drop unnecessary column
if 'Unnamed: 13' in df.columns:
    df = df.drop('Unnamed: 13', axis=1)
    print("✅ Dropped 'Unnamed: 13' column")

# 2. Clean Feedback column (remove extra space)
df['Feedback'] = df['Feedback'].str.strip()
print("✅ Cleaned 'Feedback' column (removed extra spaces)")

# 3. Check missing values
print(f"\n🔍 Missing Values:\n{df.isnull().sum()}")

# ============================================
# STEP 3: EXPLORATORY DATA ANALYSIS (EDA)
# ============================================
print("\n" + "="*60)
print("📊 STEP 3: EXPLORATORY DATA ANALYSIS")
print("="*60)

# Basic Statistics
print("\n📈 Statistical Summary (Numerical):")
print(df.describe())

print("\n📊 Categorical Columns Info:")
categorical_cols = df.select_dtypes(include=['object']).columns
for col in categorical_cols:
    print(f"\n{col}:")
    print(f"  Unique Values: {df[col].nunique()}")
    print(f"  Value Counts:\n{df[col].value_counts()}")

# ============================================
# STEP 4: VISUALIZATION (EDA Plots)
# ============================================
print("\n" + "="*60)
print("📈 STEP 4: DATA VISUALIZATION")
print("="*60)

# Set style
sns.set_style("whitegrid")
plt.figure(figsize=(18, 24))

# 1. Target Variable (Output)
plt.subplot(5, 3, 1)
output_counts = df['Output'].value_counts()
colors = ['#ff6b6b', '#4ecdc4']
plt.pie(output_counts, labels=output_counts.index, autopct='%1.1f%%', colors=colors, startangle=90)
plt.title('🎯 Output Distribution', fontsize=14, fontweight='bold')

# 2. Gender
plt.subplot(5, 3, 2)
sns.countplot(data=df, x='Gender', palette='pastel')
plt.title('👥 Gender Distribution', fontsize=14, fontweight='bold')

# 3. Age
plt.subplot(5, 3, 3)
sns.histplot(df['Age'], bins=15, kde=True, color='#6c5ce7')
plt.title('📊 Age Distribution', fontsize=14, fontweight='bold')

# 4. Marital Status
plt.subplot(5, 3, 4)
sns.countplot(data=df, x='Marital Status', palette='Set2')
plt.title('💍 Marital Status', fontsize=14, fontweight='bold')
plt.xticks(rotation=15)

# 5. Occupation
plt.subplot(5, 3, 5)
sns.countplot(data=df, x='Occupation', palette='Set3')
plt.title('💼 Occupation', fontsize=14, fontweight='bold')
plt.xticks(rotation=15)

# 6. Monthly Income
plt.subplot(5, 3, 6)
sns.countplot(data=df, x='Monthly Income', palette='coolwarm')
plt.title('💰 Monthly Income', fontsize=14, fontweight='bold')
plt.xticks(rotation=15)

# 7. Education
plt.subplot(5, 3, 7)
sns.countplot(data=df, x='Educational Qualifications', palette='viridis')
plt.title('🎓 Education', fontsize=14, fontweight='bold')
plt.xticks(rotation=15)

# 8. Family Size
plt.subplot(5, 3, 8)
sns.countplot(data=df, x='Family size', palette='rocket')
plt.title('👨‍👩‍👧‍👦 Family Size', fontsize=14, fontweight='bold')

# 9. Customer Type
plt.subplot(5, 3, 9)
sns.countplot(data=df, x='Customer Type', palette='muted')
plt.title('🛍️ Customer Type', fontsize=14, fontweight='bold')

# 10. Feedback
plt.subplot(5, 3, 10)
feedback_counts = df['Feedback'].value_counts()
plt.pie(feedback_counts, labels=feedback_counts.index, autopct='%1.1f%%', 
        colors=['#2ecc71', '#e74c3c'], startangle=90)
plt.title('📝 Feedback', fontsize=14, fontweight='bold')

# 11. Output vs Gender
plt.subplot(5, 3, 11)
pd.crosstab(df['Gender'], df['Output']).plot(kind='bar', stacked=True, 
                                             color=['#ff6b6b', '#4ecdc4'], ax=plt.gca())
plt.title('👥 Output vs Gender', fontsize=14, fontweight='bold')
plt.xlabel('Gender')
plt.legend(title='Output')

# 12. Output vs Customer Type
plt.subplot(5, 3, 12)
pd.crosstab(df['Customer Type'], df['Output']).plot(kind='bar', stacked=True, 
                                                   color=['#ff6b6b', '#4ecdc4'], ax=plt.gca())
plt.title('🛍️ Output vs Customer Type', fontsize=14, fontweight='bold')
plt.xlabel('Customer Type')
plt.legend(title='Output')

# 13. Output vs Marital Status
plt.subplot(5, 3, 13)
pd.crosstab(df['Marital Status'], df['Output']).plot(kind='bar', stacked=True, 
                                                    color=['#ff6b6b', '#4ecdc4'], ax=plt.gca())
plt.title('💍 Output vs Marital Status', fontsize=14, fontweight='bold')
plt.xlabel('Marital Status')
plt.legend(title='Output')

# 14. Output vs Occupation
plt.subplot(5, 3, 14)
pd.crosstab(df['Occupation'], df['Output']).plot(kind='bar', stacked=True, 
                                                color=['#ff6b6b', '#4ecdc4'], ax=plt.gca())
plt.title('💼 Output vs Occupation', fontsize=14, fontweight='bold')
plt.xlabel('Occupation')
plt.legend(title='Output')

# 15. Output vs Monthly Income
plt.subplot(5, 3, 15)
pd.crosstab(df['Monthly Income'], df['Output']).plot(kind='bar', stacked=True, 
                                                    color=['#ff6b6b', '#4ecdc4'], ax=plt.gca())
plt.title('💰 Output vs Monthly Income', fontsize=14, fontweight='bold')
plt.xlabel('Monthly Income')
plt.legend(title='Output')

plt.tight_layout()
plt.show()

# ============================================
# STEP 5: CORRELATION HEATMAP
# ============================================
print("\n" + "="*60)
print("🔥 STEP 5: CORRELATION HEATMAP")
print("="*60)

plt.figure(figsize=(10, 6))
numerical_cols = ['Age', 'Family size', 'latitude', 'longitude', 'Pin code']
corr_matrix = df[numerical_cols].corr()
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', linewidths=0.5, fmt='.2f')
plt.title('📊 Correlation Heatmap (Numerical Features)', fontsize=14, fontweight='bold')
plt.show()

# ============================================
# STEP 6: FEATURE ENGINEERING
# ============================================
print("\n" + "="*60)
print("⚙️ STEP 6: FEATURE ENGINEERING")
print("="*60)

# 1. Create Age Group Feature
df['Age_Group'] = pd.cut(df['Age'], bins=[18, 22, 26, 30, 34], 
                         labels=['18-22', '23-26', '27-30', '31-34'])
print("✅ Created 'Age_Group' feature")

# 2. Create Income Level Feature (Ordered)
income_order = {'No Income': 0, 'Below Rs.10000': 1, '10001 to 25000': 2, 
                '25001 to 50000': 3, 'More than 50000': 4}
df['Income_Level'] = df['Monthly Income'].map(income_order)
print("✅ Created 'Income_Level' numeric feature")

# 3. Create Family Size Category
df['Family_Category'] = pd.cut(df['Family size'], bins=[0, 2, 4, 6], 
                               labels=['Small', 'Medium', 'Large'])
print("✅ Created 'Family_Category' feature")

print("\n📊 Feature Engineering Complete!")

# ============================================
# STEP 7: ENCODING (Label Encoding)
# ============================================
print("\n" + "="*60)
print("🔢 STEP 7: ENCODING")
print("="*60)

# Create a copy for modeling
df_encoded = df.copy()

# Label Encoding for categorical columns
le_dict = {}
categorical_cols = ['Gender', 'Marital Status', 'Occupation', 'Educational Qualifications', 
                   'Customer Type', 'Output', 'Feedback']

for col in categorical_cols:
    le = LabelEncoder()
    df_encoded[col] = le.fit_transform(df_encoded[col])
    le_dict[col] = le
    print(f"✅ Encoded '{col}' - Unique values: {le.classes_}")

# Drop original columns that were used for feature engineering
df_encoded = df_encoded.drop(['Monthly Income', 'Age_Group', 'Family_Category'], axis=1)
print("✅ Dropped original categorical columns after encoding")

# ============================================
# STEP 8: FEATURE SELECTION
# ============================================
print("\n" + "="*60)
print("🎯 STEP 8: FEATURE SELECTION")
print("="*60)

# Separate features and target
X = df_encoded.drop(['Output'], axis=1)
y = df_encoded['Output']

print(f"🔍 Features: {X.shape[1]}")
print(f"🎯 Target: {y.name}")

# Feature importance using Random Forest
rf = RandomForestClassifier(n_estimators=100, random_state=42)
rf.fit(X, y)

# Feature importance plot
plt.figure(figsize=(12, 6))
importance = pd.DataFrame({
    'Feature': X.columns,
    'Importance': rf.feature_importances_
}).sort_values('Importance', ascending=False)

sns.barplot(data=importance, x='Importance', y='Feature', palette='viridis')
plt.title('🎯 Feature Importance (Random Forest)', fontsize=14, fontweight='bold')
plt.xlabel('Importance Score')
plt.tight_layout()
plt.show()

print("\n📊 Top 10 Important Features:")
print(importance.head(10))

# Select top features (85% importance threshold)
cumsum = importance['Importance'].cumsum()
n_features = (cumsum <= 0.85).sum() + 1
top_features = importance.head(n_features)['Feature'].tolist()
print(f"\n✅ Selected {n_features} features (85% cumulative importance)")

# ============================================
# STEP 9: TRAIN/TEST SPLIT
# ============================================
print("\n" + "="*60)
print("📊 STEP 9: TRAIN/TEST SPLIT")
print("="*60)

# Use top features only
X_selected = X[top_features]

# Split
X_train, X_test, y_train, y_test = train_test_split(X_selected, y, test_size=0.2, random_state=42, stratify=y)

print(f"✅ Training set: {X_train.shape[0]} samples")
print(f"✅ Testing set: {X_test.shape[0]} samples")
print(f"📊 Class Distribution in Training:\n{y_train.value_counts()}")
print(f"📊 Class Distribution in Testing:\n{y_test.value_counts()}")

# ============================================
# STEP 10: SCALING
# ============================================
print("\n" + "="*60)
print("⚡ STEP 10: FEATURE SCALING")
print("="*60)

scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)
print("✅ Features scaled using StandardScaler")

# ============================================
# STEP 11: MODEL TRAINING & EVALUATION
# ============================================
print("\n" + "="*60)
print("🤖 STEP 11: MODEL TRAINING & EVALUATION")
print("="*60)

# Define models
models = {
    'Logistic Regression': LogisticRegression(random_state=42),
    'Decision Tree': DecisionTreeClassifier(random_state=42),
    'Random Forest': RandomForestClassifier(n_estimators=100, random_state=42),
    'Gradient Boosting': GradientBoostingClassifier(random_state=42),
    'SVM': SVC(random_state=42),
    'KNN': KNeighborsClassifier()
}

# Train and evaluate
results = []
for name, model in models.items():
    print(f"\n{'='*40}")
    print(f"📌 Training: {name}")
    print('='*40)
    
    # Train
    model.fit(X_train_scaled, y_train)
    
    # Predict
    y_pred = model.predict(X_test_scaled)
    
    # Metrics
    accuracy = accuracy_score(y_test, y_pred)
    precision = precision_score(y_test, y_pred)
    recall = recall_score(y_test, y_pred)
    f1 = f1_score(y_test, y_pred)
    
    print(f"✅ Accuracy: {accuracy:.4f}")
    print(f"✅ Precision: {precision:.4f}")
    print(f"✅ Recall: {recall:.4f}")
    print(f"✅ F1-Score: {f1:.4f}")
    
    results.append({
        'Model': name,
        'Accuracy': accuracy,
        'Precision': precision,
        'Recall': recall,
        'F1-Score': f1
    })
    
    # Confusion Matrix
    cm = confusion_matrix(y_test, y_pred)
    plt.figure(figsize=(4, 3))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
                xticklabels=['No', 'Yes'], yticklabels=['No', 'Yes'])
    plt.title(f'Confusion Matrix - {name}')
    plt.show()

# ============================================
# STEP 12: MODEL COMPARISON
# ============================================
print("\n" + "="*60)
print("📊 STEP 12: MODEL COMPARISON")
print("="*60)

# Create comparison DataFrame
results_df = pd.DataFrame(results)
print("\n📊 Model Performance Summary:")
print(results_df.to_string(index=False))

# Plot comparison
plt.figure(figsize=(12, 6))
results_melted = results_df.melt(id_vars=['Model'], var_name='Metric', value_name='Score')
sns.barplot(data=results_melted, x='Model', y='Score', hue='Metric', palette='Set2')
plt.title('📊 Model Performance Comparison', fontsize=14, fontweight='bold')
plt.xlabel('Model')
plt.ylabel('Score')
plt.legend(bbox_to_anchor=(1.05, 1))
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()

# ============================================
# STEP 13: BEST MODEL SELECTION
# ============================================
print("\n" + "="*60)
print("🏆 STEP 13: BEST MODEL SELECTION")
print("="*60)

best_model_name = results_df.loc[results_df['Accuracy'].idxmax(), 'Model']
best_model = models[best_model_name]
best_accuracy = results_df['Accuracy'].max()

print(f"🏆 Best Model: {best_model_name}")
print(f"✅ Accuracy: {best_accuracy:.4f}")

# Train best model on full data
best_model.fit(X_train_scaled, y_train)
y_pred_best = best_model.predict(X_test_scaled)

print(f"\n📊 Classification Report for Best Model:")
print(classification_report(y_test, y_pred_best, target_names=['No', 'Yes']))

# ============================================
# STEP 14: PREDICTION FUNCTION
# ============================================
print("\n" + "="*60)
print("🎯 STEP 14: PREDICTION FUNCTION")
print("="*60)

def predict_order(customer_data):
    """
    Predict if customer will order food online
    
    Parameters:
    customer_data: dict with features
    
    Returns:
    prediction: 'Yes' or 'No'
    """
    # Convert to DataFrame
    df_input = pd.DataFrame([customer_data])
    
    # Encode categorical features
    for col in categorical_cols:
        if col in df_input.columns and col in le_dict:
            try:
                df_input[col] = le_dict[col].transform(df_input[col])
            except:
                # If value not seen in training, use most frequent
                df_input[col] = le_dict[col].transform([le_dict[col].classes_[0]])
    
    # Select features
    df_input = df_input[top_features]
    
    # Scale
    df_input_scaled = scaler.transform(df_input)
    
    # Predict
    pred = best_model.predict(df_input_scaled)[0]
    
    return 'Yes' if pred == 1 else 'No'

print("✅ Prediction function created!")
print("\n🔮 Example Prediction:")
sample = X_test.iloc[0].to_dict()
prediction = predict_order(sample)
print(f"Sample prediction: {prediction}")

# ============================================
# STEP 15: SAVE BEST MODEL (for deployment)
# ============================================
print("\n" + "="*60)
print("💾 STEP 15: SAVE MODEL")
print("="*60)

import joblib

# Save model and preprocessing objects
joblib.dump(best_model, 'best_model.pkl')
joblib.dump(scaler, 'scaler.pkl')
joblib.dump(le_dict, 'label_encoders.pkl')
joblib.dump(top_features, 'selected_features.pkl')

print("✅ Model saved as 'best_model.pkl'")
print("✅ Scaler saved as 'scaler.pkl'")
print("✅ Label encoders saved as 'label_encoders.pkl'")
print("✅ Selected features saved as 'selected_features.pkl'")

print("\n" + "="*60)
print("🎉 PIPELINE COMPLETE! 🎉")
print("="*60)
print("\n📊 Summary:")
print(f"• Dataset: {df.shape[0]} rows, {df.shape[1]} columns")
print(f"• Best Model: {best_model_name}")
print(f"• Best Accuracy: {best_accuracy:.4f}")
print(f"• Features Used: {len(top_features)}")
print("\n🚀 Ready for deployment with Streamlit!")
